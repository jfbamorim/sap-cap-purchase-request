# ──────────────────────────────────────────────────────────────────────────────
# Purchase Request Items – CRUD + Validations
# ──────────────────────────────────────────────────────────────────────────────

@baseUrl = http://localhost:4004/odata/v4/pr

### GET all items of a specific PR
GET {{baseUrl}}/PurchaseRequests(55555555-5555-5555-5555-000000000005)/items

### CREATE item – valid (non-critical material, no supplier required)
POST {{baseUrl}}/PurchaseRequestItems
Content-Type: application/json

{
    "pr_id": "55555555-5555-5555-5555-000000000005",
    "lineNumber": 1,
    "material_id": "11111111-1111-1111-1111-000000000005",
    "quantity": 10.000,
    "unitOfMeasure": "PC",
    "unitPrice": 12.50,
    "requiredDate": "2026-06-01"
}

### CREATE item – VAL-04 quantity zero
# Expected: 400 – Quantity and unit price must be positive values
POST {{baseUrl}}/PurchaseRequestItems
Content-Type: application/json

{
    "pr_id": "55555555-5555-5555-5555-000000000005",
    "lineNumber": 2,
    "material_id": "11111111-1111-1111-1111-000000000005",
    "quantity": 0,
    "unitOfMeasure": "PC",
    "unitPrice": 12.50,
    "requiredDate": "2026-06-01"
}

### CREATE item – VAL-04 unit price negative
# Expected: 400 – Quantity and unit price must be positive values
POST {{baseUrl}}/PurchaseRequestItems
Content-Type: application/json

{
    "pr_id": "55555555-5555-5555-5555-000000000005",
    "lineNumber": 2,
    "material_id": "11111111-1111-1111-1111-000000000005",
    "quantity": 5.000,
    "unitOfMeasure": "PC",
    "unitPrice": -10.00,
    "requiredDate": "2026-06-01"
}

### CREATE item – VAL-05 critical material without supplier
# Expected: 400 – Critical materials require a preferred supplier
POST {{baseUrl}}/PurchaseRequestItems
Content-Type: application/json

{
    "pr_id": "55555555-5555-5555-5555-000000000005",
    "lineNumber": 2,
    "material_id": "11111111-1111-1111-1111-000000000003",
    "quantity": 1.000,
    "unitOfMeasure": "UN",
    "unitPrice": 9500.00,
    "requiredDate": "2026-06-01"
}

### CREATE item – VAL-05 critical material with supplier (valid)
POST {{baseUrl}}/PurchaseRequestItems
Content-Type: application/json

{
    "pr_id": "55555555-5555-5555-5555-000000000005",
    "lineNumber": 2,
    "material_id": "11111111-1111-1111-1111-000000000003",
    "supplier_id": "22222222-2222-2222-2222-000000000007",
    "quantity": 1.000,
    "unitOfMeasure": "UN",
    "unitPrice": 9500.00,
    "requiredDate": "2026-06-01"
}
